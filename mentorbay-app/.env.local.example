# MentorBay environment variables
# For local development: copy this file to ".env.local" and fill in real values.
# In production (Vercel): set these in Project Settings -> Environment Variables.
#
# IMPORTANT: NEXT_PUBLIC_SUPABASE_URL must be the bare project URL only -
# no trailing slash and no path like /rest/v1.
# Correct:   https://YOUR-PROJECT-REF.supabase.co
# Wrong:     https://YOUR-PROJECT-REF.supabase.co/rest/v1/

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
