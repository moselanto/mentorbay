# MentorBay environment variables
# Local dev: copy to ".env.local" and fill in. Production: set in Vercel.

# Required - Supabase. NEXT_PUBLIC_SUPABASE_URL is the bare project URL only
# (no trailing slash, no /rest/v1).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (server-only secret, NEVER prefix with NEXT_PUBLIC_).
# Supabase -> Project Settings -> API -> service_role key. Required for the
# M-Pesa callback (/api/mpesa/callback) to apply payments: it bypasses RLS to
# write the payments ledger, enrollment totals, and wallet/commission balances
# the mentee is not allowed to touch. Without it the callback silently no-ops
# (STK prompt succeeds on the phone but no money is ever applied).
SUPABASE_SERVICE_ROLE_KEY=

# --- M-Pesa (Safaricom Daraja) STK Push -------------------------------------
# Payments are env-gated: if these are unset the app hides M-Pesa and falls back
# to the simulated test button. Start on SANDBOX, then swap the values for
# PRODUCTION later - no code change needed.
#
# MPESA_ENV: "sandbox" (default) or "production".
MPESA_ENV=sandbox
# Daraja app consumer key / secret (developer.safaricom.co.ke -> My Apps).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Business shortcode. Sandbox uses 174379. Production = your Paybill/Till.
MPESA_SHORTCODE=174379
# Lipa na M-Pesa Online passkey (sandbox passkey from the Daraja portal;
# production passkey is issued with your Paybill/Till go-live).
MPESA_PASSKEY=
# Public HTTPS URL Safaricom POSTs the result to. MUST be reachable from the
# internet (localhost will NOT work) and MUST point at this app's callback route.
# On Vercel, prefer the STABLE branch alias over a per-deployment hash URL so it
# survives every redeploy, e.g.:
#   https://mentorbay-git-feature-mpesa-payments-<scope>.vercel.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback

# Optional - allow the simulated (fake) test-payment button in the UI. Leave
# unset/false in any environment real users can reach so they only pay via M-Pesa.
# Set to "true" only for internal testing.
NEXT_PUBLIC_ALLOW_SIMULATED_PAYMENTS=

# Optional - admin email notifications when a new mentor signs up.
# Leave blank to disable (sign-up still works; admin sees pending in dashboard).
# Get a free key at resend.com. ADMIN_NOTIFY_EMAIL is where alerts are sent.
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
NOTIFY_FROM_EMAIL=MentorBay <onboarding@resend.dev>
