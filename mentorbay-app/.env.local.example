# MentorBay environment variables
# Local dev: copy to ".env.local" and fill in. Production: set in Vercel.

# Required - Supabase. NEXT_PUBLIC_SUPABASE_URL is the bare project URL only
# (no trailing slash, no /rest/v1).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional - admin email notifications when a new mentor signs up.
# Leave blank to disable (sign-up still works; admin sees pending in dashboard).
# Get a free key at resend.com. ADMIN_NOTIFY_EMAIL is where alerts are sent.
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
NOTIFY_FROM_EMAIL=MentorBay <onboarding@resend.dev>
